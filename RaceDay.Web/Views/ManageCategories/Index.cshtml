@model ManageCategoriesViewModel
@{ ViewData["Title"] = "Categories · " + Model.Event.EventName; var f = Model.Form; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="ManageEvents" asp-action="Index">Events</a></li>
        <li class="breadcrumb-item"><a asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@Model.Event.EventId">@Model.Event.EventName</a></li>
        <li class="breadcrumb-item active" aria-current="page">Categories</li>
    </ol>
</nav>

<div class="rd-page-head">
    <div>
        <h1 class="rd-h1">Categories</h1>
        <p class="text-secondary mb-0">@Model.Event.EventName · @Fmt.Date(Model.Event.EventDate)</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        @if (Model.Categories.Count == 0)
        {
            <div class="rd-empty rd-empty-sm"><i class="bi bi-tags"></i><p class="mb-0">No categories yet. Add one so participants can enrol.</p></div>
        }
        else
        {
            <div class="card rd-card"><div class="table-responsive">
                <table class="table rd-table align-middle mb-0">
                    <thead><tr><th>Category</th><th>Type</th><th>Criteria</th><th class="text-end">Capacity</th><th class="text-end">Fee</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr class="@(c.CategoryId == f.CategoryId ? "table-active" : "")">
                            <td class="fw-semibold">@c.CategoryName</td>
                            <td><span class="rd-badge rd-badge-grey">@c.CategoryType</span></td>
                            <td>@c.Criteria</td>
                            <td class="text-end">@c.MaxParticipants</td>
                            <td class="text-end">@Fmt.Money(c.EntryFee)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Index" asp-route-eventId="@Model.Event.EventId" asp-route-edit="@c.CategoryId" class="btn btn-sm btn-rd-outline" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline" data-confirm="Delete the “@c.CategoryName” category?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card rd-card"><div class="card-body p-4">
            <h2 class="rd-h3">@(Model.Editing ? "Edit category" : "Add a category")</h2>
            <form asp-action="Save" asp-route-eventId="@Model.Event.EventId" method="post" novalidate>
                <partial name="_FormErrors" />
                <input type="hidden" asp-for="Form.CategoryId" />
                <div class="mb-3">
                    <label asp-for="Form.CategoryName" class="form-label"></label>
                    <input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. 10 km or Under 20" />
                    <span asp-validation-for="Form.CategoryName" class="rd-field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Form.CategoryType" class="form-label"></label>
                    <select asp-for="Form.CategoryType" class="form-select" id="categoryType">
                        <option value="Distance">Distance (e.g. 10 km)</option>
                        <option value="Age">Age group (e.g. 18–34)</option>
                    </select>
                    <span asp-validation-for="Form.CategoryType" class="rd-field-error"></span>
                </div>
                <div class="mb-3" id="distanceFields">
                    <label asp-for="Form.Distance" class="form-label"></label>
                    <input asp-for="Form.Distance" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="Form.Distance" class="rd-field-error"></span>
                </div>
                <div class="row" id="ageFields">
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MinAge" class="form-label"></label>
                        <input asp-for="Form.MinAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="Form.MinAge" class="rd-field-error"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MaxAge" class="form-label"></label>
                        <input asp-for="Form.MaxAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="Form.MaxAge" class="rd-field-error"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Form.MaxParticipants" class="form-label"></label>
                        <input asp-for="Form.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Form.MaxParticipants" class="rd-field-error"></span>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="Form.EntryFee" class="form-label"></label>
                        <input asp-for="Form.EntryFee" type="number" min="0" step="0.01" class="form-control" />
                        <span asp-validation-for="Form.EntryFee" class="rd-field-error"></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-rd-primary">@(Model.Editing ? "Save category" : "Add category")</button>
                    @if (Model.Editing)
                    {
                        <a asp-action="Index" asp-route-eventId="@Model.Event.EventId" class="btn btn-link">Cancel</a>
                    }
                </div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var type = document.getElementById('categoryType');
            var dist = document.getElementById('distanceFields');
            var age = document.getElementById('ageFields');
            function sync() {
                var isDist = type.value === 'Distance';
                dist.hidden = !isDist;
                age.hidden = isDist;
            }
            type.addEventListener('change', sync);
            sync();
        })();
    </script>
}
