@* Shows errors that aren't tied to one field (e.g. messages from the API). *@
@if (ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry is { Errors.Count: > 0 })
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        @if (entry.Errors.Count == 1)
        {
            @entry.Errors[0].ErrorMessage
        }
        else
        {
            <ul class="mb-0 ps-3">
                @foreach (var e in entry.Errors)
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        }
    </div>
}
