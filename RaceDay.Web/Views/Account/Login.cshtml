@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card rd-card rd-auth-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="rd-h1">Welcome back</h1>
                <p class="text-secondary">Log in to manage or join races.</p>
                <form asp-action="Login" method="post" novalidate>
                    <partial name="_FormErrors" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="rd-field-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="rd-field-error"></span>
                    </div>
                    <button type="submit" class="btn btn-rd-primary w-100">Log in</button>
                </form>
                <p class="text-center mt-4 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
            </div>
        </div>
    </div>
</div>
