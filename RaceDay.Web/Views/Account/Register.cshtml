@model RegisterViewModel
@{ ViewData["Title"] = "Join RaceDay"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card rd-card rd-auth-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="rd-h1">Join RaceDay</h1>
                <p class="text-secondary">Create your account in under a minute.</p>
                <form asp-action="Register" method="post" novalidate>
                    <partial name="_FormErrors" />

                    <label class="form-label">I want to…</label>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="roleP" />
                            <label class="btn rd-role-choice w-100" for="roleP"><i class="bi bi-person-running"></i><strong>Race</strong><small>Find and enter events</small></label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleO" />
                            <label class="btn rd-role-choice w-100" for="roleO"><i class="bi bi-flag-fill"></i><strong>Organise</strong><small>Create and run events</small></label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="rd-field-error"></span>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="rd-field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="rd-field-error"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="rd-field-error"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="rd-field-error"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-rd-primary w-100">Create account</button>
                </form>
                <p class="text-center mt-4 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>
